# GNews API key - required for live news
# Get a free key at https://gnews.io/
GNEWS_API_KEY=your_api_key_here
NEWSDATA_API_KEY=your_newsdata_api_key_here
NEWSDATA_API_URL=https://newsdata.io/api/1/latest
OPENSKY_CLIENT_ID=your_opensky_client_id_here
OPENSKY_CLIENT_SECRET=your_opensky_client_secret_here
OPENSKY_TOKEN_URL=https://opensky-network.org/api/oauth/token
OPENSKY_API_URL=https://opensky-network.org/api/states/all
OPENSKY_BBOX=6.0,68.0,38.0,98.0
OPENSKY_MAX_STATES=12
AISSTREAM_API_KEY=your_aisstream_api_key_here
AISSTREAM_WS_URL=wss://stream.aisstream.io/v0/stream
AISSTREAM_BBOX=5.0,65.0,28.0,96.0
AISSTREAM_MAX_MESSAGES=2
AISSTREAM_TIMEOUT_SECONDS=8
YOUTUBE_API_KEY=your_youtube_api_key_here

# Daily caps to protect free-tier credits
# Set to 0 to disable external calls for that provider
GNEWS_DAILY_LIMIT=80
NEWSDATA_DAILY_LIMIT=80
REDDIT_DAILY_LIMIT=120
OPENSKY_DAILY_LIMIT=120
AISSTREAM_DAILY_LIMIT=120

# Optional floor between calls (seconds). Keep 0 to use automatic even spacing.
GNEWS_MIN_INTERVAL_SECONDS=0
NEWSDATA_MIN_INTERVAL_SECONDS=0
REDDIT_MIN_INTERVAL_SECONDS=0
OPENSKY_MIN_INTERVAL_SECONDS=0
AISSTREAM_MIN_INTERVAL_SECONDS=0

# Reuse last successful GNews responses when pacing blocks a new fetch
GNEWS_CACHE_MAX_AGE_SECONDS=21600

# Reuse cached OSINT data for this many seconds before hitting APIs again
OSINT_CACHE_TTL_SECONDS=3600
